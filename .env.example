# msteams-mcp configuration. Copy to .env and `chmod 600 .env`. Never commit .env.

# Your Entra app registration (docs/ENTRA-SETUP.md). Not secrets, but tenant-specific.
TENANT_ID=
CLIENT_ID=

# Tools exposed to MCP clients (npm run tools lists all). Scopes are derived from these.
ENABLED_TOOLS=auth_status,get_current_user,list_chats,get_chat_messages
# Must be true to enable any write tool (none exist in v0.1)
ALLOW_WRITE_TOOLS=false

# Local HTTP endpoint: http://127.0.0.1:3978/mcp (loopback only)
MCP_HOST=127.0.0.1
MCP_PORT=3978
# Bearer token MCP clients must send. Generate: openssl rand -hex 24
MCP_ACCESS_TOKEN=

# Optional
# TOKEN_CACHE_PATH=~/.msteams-mcp/token-cache.json
# LOG_FILE=./msteams-mcp.log.jsonl
